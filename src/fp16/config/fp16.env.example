# ============================================================================
# fp16.env.example — SEMUA setelan yang berbeda per mesin/GPU untuk FP16.
#
# Pakai:
#   cp config/fp16.env.example config/fp16.env
#   # edit kalau GPU-mu bukan A100 80GB (lihat catatan tiap variabel)
#   ./setup.sh && ./run.sh --preset smoke
#
# Nilai-nilai di bawah adalah yang TERBUKTI menyelesaikan run produksi FP16
# sampai 55.245/55.296 baris (99,91%), bukan tebakan -- lihat
# ../../docs/README_FP16.md bagian 5-6 untuk pengukurannya.
#
# Padanan file ini untuk INT8: ../../src/int8/config/int8.env.example.
# Banyak angka BERBEDA nilainya -- model INT8 26 GB vs FP16 13 GB, arena dan
# PER_PROSES-nya tidak bisa disalin mentah antar keduanya.
# ============================================================================

# --- Lokasi dasar di instance -----------------------------------------------
ROOT=/workspace/fidelity

# --- Identitas model ---------------------------------------------------------
# Boleh diisi ID repo HF ("org/nama") ATAU PATH LOKAL kalau bobotnya sudah
# ada di mesin ini/server lain yang dipasang lewat volume bersama (mis. NFS,
# atau instance lain di host yang sama) -- syaratnya direktori itu punya
# config.json + minimal satu *.safetensors langsung di dalamnya (struktur
# sama seperti snapshot HF Hub). Kalau path lokal terdeteksi valid,
# _download_7b.py melewati unduhan HF sama sekali (lihat pipeline/_download_7b.py).
#   MODEL_ID=/workspace/shared_models/llama2-7b-hf
MODEL_ID=NousResearch/Llama-2-7b-hf   # MHA; meta-llama/Llama-2-7b-hf gated
PRECISION=float16

# --- Bit width & jumlah injeksi ----------------------------------------------
# FP16 = 16 bit (0-15). Kalau ini diisi 0-7 (nilai INT8), 8 bit tinggi tidak
# pernah teruji -- bit eksponen FP16 (bit 10-14) justru yang paling bernilai
# diuji karena dampaknya paling ekstrem (lihat README_FP16.md bagian 1).
BITS=0-15
RUNS=2

# --- Arena GPU & konfigurasi per proses --------------------------------------
# SATU konfigurasi per proses (PER_PROSES=1) -- BUKAN 3-6 seperti INT8. Model
# FP16 cuma 13 GB dan muat modelnya murah (~26 detik), jadi arena baru per
# proses itu murah. Menaikkan PER_PROSES di sini tidak menghemat apa pun dan
# cuma menambah resiko arena penuh di ekor proses.
PER_PROSES=1

# 45 GB pertama kali terbukti aman (bukan 30, yang segfault di node
# Max/ReduceMax/Slice -- BMM attention 4-D, tensor terbesar). Lalu dinaikkan
# ke 60 saat run produksi karena kartu 80GB dan pemakaian puncak terukur
# cuma 56GB -- 45 ternyata membuat fault model kelima/keenam (RANDOM,
# RANDOM_BITFLIP) kehabisan arena di konfigurasi berat. 60 inilah yang
# dipakai sampai run selesai.
ORT_GPU_MEM_LIMIT_GB=60
FIDELITY_POOL_GB=60

# --- Pengawas (pengawas_fp16.sh) ---------------------------------------------
# Bawaan skrip, tidak pernah perlu diubah untuk FP16 -- laju error rendah
# (0,7%) berarti putaran jarang perlu diulang sampai batas ini.
MAKS_PUTARAN=8

# --- Watchdog VRAM (penjaga_vram.sh, dipasang lewat cron) -------------------
# CATATAN: run produksi FP16 yang sudah selesai sebenarnya memakai
# penjaga_fp16.sh (versi lama, cuma menangani proses mati) -- itu memadai
# karena error VRAM jarang terjadi. README_FP16.md eksplisit bilang: untuk
# run FP16 BARU pakai penjaga_vram.sh (lebih tangguh, juga menangani
# kegagalan alokasi VRAM yang diam-diam melewatkan baris). setup.sh/run.sh
# di sini konsisten memakai penjaga_vram.sh.
#
# Ambang 50 error baru -- FP16 jarang mendekati ini (beda dari INT8 yang
# perlu dinaikkan sampai 150 di H200).
AMBANG_ERR=50

# Jangan biarkan watchdog menurunkan arena di bawah ini. 45 adalah titik
# yang terbukti aman (lihat catatan ORT_GPU_MEM_LIMIT_GB di atas); di bawah
# itu node BMM attention 4-D mulai segfault, bukan cuma melambat.
ARENA_MIN=45

# --- Target run penuh (dipakai run.sh --preset full & untuk hitung TARGET) --
# 288 konfigurasi x 6 fault model x 16 bit x 2 run = 55296.
N_CFG=288
