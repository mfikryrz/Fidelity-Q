# ============================================================================
# int8.env.example — SEMUA setelan yang berbeda per mesin/GPU untuk INT8.
#
# Pakai:
#   cp config/int8.env.example config/int8.env
#   # edit kalau GPU-mu bukan H200 140GB (lihat catatan tiap variabel)
#   ./setup.sh && ./run.sh --preset smoke
#
# Sebelum berkas ini ada, angka-angka di bawah tertanam langsung di dalam
# skrip (jalankan_fp16.sh, pengawas_fp16.sh, penjaga_vram.sh) dan berbeda
# defaultnya di TIGA tempat sekaligus -- orang yang menjalankan ulang harus
# tahu enam+ variabel mana yang WAJIB di-override untuk INT8 (bukan FP16),
# atau diam-diam memakai setelan FP16 yang salah untuk INT8. Berkas ini
# adalah satu-satunya tempat untuk itu.
#
# Skrip di bawah TIDAK diubah isinya -- ini cuma mengisi variabel yang sudah
# mereka baca lewat ${VAR:-default}. Kalau berkas ini tidak ada, skrip
# baca defaultnya sendiri (yang defaultnya untuk FP16, bukan INT8 -- jadi
# JANGAN jalankan run.sh tanpa berkas ini untuk INT8).
# ============================================================================

# --- Lokasi dasar di instance -----------------------------------------------
# Konvensi tetap di seluruh kode ini; ubah hanya kalau instance-mu memang
# ditata beda.
ROOT=/workspace/fidelity

# --- Identitas model ---------------------------------------------------------
# Boleh diisi ID repo HF ("org/nama") ATAU PATH LOKAL kalau bobotnya sudah
# ada di mesin ini/server lain yang dipasang lewat volume bersama -- lihat
# penjelasan lengkap di ../../fp16/config/fp16.env.example (sama persis
# untuk INT8, cuma bobot mentahnya yang dipakai bersama; SmoothQuant tetap
# jalan di atas bobot itu apa pun sumbernya).
#   MODEL_ID=/workspace/shared_models/llama2-7b-hf
MODEL_ID=NousResearch/Llama-2-7b-hf   # MHA; meta-llama/Llama-2-7b-hf gated
PRECISION=int8                        # menentukan _config.py pakai onnx_int8

# --- Bit width & jumlah injeksi ----------------------------------------------
# INT8 = 8 bit. Kalau ini masih 0-15 (bawaan skrip, ditulis untuk FP16),
# 8 bit teratas tidak berarti apa-apa untuk model 8-bit dan run jadi 2x lipat
# lebih mahal untuk data yang tidak valid.
BITS=0-7
RUNS=2

# --- Arena GPU & konfigurasi per proses --------------------------------------
# INT8 = fake-INT8, disimpan & dieksekusi FP32 -> model 26 GB, BUKAN 13 GB
# seperti FP16. Nilai FP16 (60GB arena, PER_PROSES=1) akan membuat INT8
# gagal alokasi terus-menerus atau menghabiskan 46 jam cuma memuat model
# ulang. Lihat README_INT8.md bagian 4-5 untuk pengukurannya.
#
# Nilai di bawah adalah yang TERBUKTI di H200 140GB (16 Sep 2026), bukan
# tebakan -- lihat status-berjalan-20260914 di memori proyek untuk angka
# perbandingan A100 80GB (arena=35 juga, tapi PER_PROSES=3 dan
# AMBANG_ERR=50 karena muat model 9,6 menit vs 3,8 menit di H200).
ORT_GPU_MEM_LIMIT_GB=35
FIDELITY_POOL_GB=35
PER_PROSES=2

# --- Pengawas (pengawas_fp16.sh) ---------------------------------------------
# Berapa kali mengulang seluruh sweep sebelum menyerah kalau baris berhenti
# bertambah. 8 = bawaan skrip (ditulis untuk FP16, sweep-nya lebih murah).
# INT8 muat modelnya jauh lebih mahal, jadi tiap putaran ekstra mahal --
# 12 dipakai saat run produksi (lanjutkan_int8.sh).
MAKS_PUTARAN=12

# --- Watchdog VRAM (penjaga_vram.sh, dipasang lewat cron) -------------------
# AMBANG_ERR = berapa error alokasi BARU sebelum watchdog menurunkan setelan.
# 10 (bawaan skrip) dipilih untuk A100 dengan muat model 9,6 menit. Di H200
# (muat model 3,8 menit) aritmetikanya beda dan 10 terlalu ketat -- akan
# menurunkan PER_PROSES ke 1 padahal error 1,6% masih dalam batas wajar
# (lihat README_INT8.md bagian 4: "bukan alasan menurunkan setelan").
# Kalau GPU-mu bukan H200, mulai dari 50 (nilai A100 yang terbukti) lalu
# amati logs/penjaga_vram.log.
AMBANG_ERR=150

# Jangan biarkan watchdog menurunkan arena di bawah ini -- model 26 GB masih
# perlu ruang kerja di atasnya, di bawah titik ini SEMUA baris gagal, bukan
# cuma melambat.
ARENA_MIN=35

# --- Target run penuh (dipakai run.sh --preset full & untuk hitung TARGET) --
# 288 konfigurasi x 6 fault model x 8 bit x 2 run = 27648. Kalau N_CFG di
# bawah diubah, TARGET di run.sh mengikuti otomatis -- tidak perlu diutak-atik
# manual.
N_CFG=288
